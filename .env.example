# Copy to .env.local and fill in. Never commit real values.
#
# Variables prefixed VITE_ are compiled into the browser bundle and are public.
# Everything else is read only by the serverless functions in /api.

# --- Browser (public) ---------------------------------------------------------

# OpenWeatherMap: primary weather source. https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=

# RapidAPI key, subscribed to "GeoDB Cities" (Basic plan): city autocomplete.
# https://rapidapi.com/wirefreethought/api/geodb-cities
VITE_RAPIDAPI_KEY=

# Web Push public key. Generate the pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Server only (reminder sender, added in a later step) ----------------------

# Web Push private key (the other half of the pair above), and the subject push
# services use to identify the sender: the site's production URL, or a mailto:
# address. The schedule script also reads it as the site to call.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Upstash Redis REST credentials: stores push subscriptions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash signing keys: verify that the 5-minute trigger is genuine.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Local only (never set on the host) ---------------------------------------

# Upstash QStash API endpoint and token. Used once, from your machine, to
# create the 5-minute schedule that triggers the reminder sender. The deployed
# functions never need them: they only verify signatures, with the two keys above.
QSTASH_URL=
QSTASH_TOKEN=
